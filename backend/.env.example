# LabFlow 환경변수 설정 파일
# 사용법: cp .env.example .env  →  .env 파일에 실제 값 입력
# ⚠️  .env 파일은 절대 Git에 커밋하지 마세요!

# ══════════════════════════════════════════════════════════════════
# 핵심 기능 1: LLM 챗봇 기반 자연어 예약
# ══════════════════════════════════════════════════════════════════

# Claude API 키 (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# true: API Key 없이 Mock 응답으로 데모 가능 (발표용)
LLM_MOCK_MODE=true

# ══════════════════════════════════════════════════════════════════
# 핵심 기능 2: AI 매뉴얼 챗봇 (RAG)
# ══════════════════════════════════════════════════════════════════

# OpenAI API 키 — 임베딩 생성용 (https://platform.openai.com)
OPENAI_API_KEY=

# 사용할 임베딩 모델
EMBEDDING_MODEL=text-embedding-3-small

# true: OpenAI Key 없이 Hash 기반 Mock 임베딩으로 데모 가능 (발표용)
RAG_MOCK_MODE=true

# PDF 매뉴얼 업로드 저장 경로
MANUAL_UPLOAD_DIR=./uploads/manuals

# FAISS 인덱스 저장 경로
FAISS_INDEX_DIR=./vectorstores/faiss

# RAG 검색 파라미터
# RAG_TOP_K=5
# RAG_SCORE_THRESHOLD=0.3

# ══════════════════════════════════════════════════════════════════
# 데이터베이스
# ══════════════════════════════════════════════════════════════════

# sqlite (기본, 로컬 개발) 또는 postgresql (배포)
DB_MODE=sqlite

# PostgreSQL 사용 시 (DB_MODE=postgresql일 때)
# DATABASE_URL=postgresql://labflow_user:labflow_pass@localhost:5432/labflow

# ══════════════════════════════════════════════════════════════════
# Google Calendar API (선택 기능)
# ══════════════════════════════════════════════════════════════════

# Google Cloud Console → API & Services → OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/gcal/callback
