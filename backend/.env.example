# LabFlow 환경변수 설정 파일
# 이 파일을 복사해서 .env 로 이름 바꾼 후 실제 값을 입력하세요
# cp .env.example .env

# ─── Anthropic API ─────────────────────────────────────────────
# https://console.anthropic.com 에서 발급
ANTHROPIC_API_KEY=sk-ant-api03-여기에_실제_키_입력

# ─── DB 설정 ───────────────────────────────────────────────────
# sqlite (로컬 개발) 또는 postgresql (배포)
DB_MODE=sqlite

# ─── Google Calendar API (선택) ────────────────────────────────
# Google Cloud Console → API & Services → Credentials
# OAuth 2.0 Client ID (Web application) 타입으로 생성
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/gcal/callback
